<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Real network to Gemini (LLM + TTS) and YouTube (NewPipe download). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground media-playback service: keeps KOLAI playing with the screen
         off / in the car / from the lock screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+ runtime notification permission (media notification). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="KOLAI"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:largeHeap="true">
        <!--
          largeHeap: a block decodes up to 3 full songs to mono 44.1k FloatArrays
          (~35 MB each) PLUS the growing mix timeline, so peak heap is ~150 MB.
          KNOWN MEMORY COST to optimize later: decode/trim/mix incrementally
          (stream a song in, crossfade, release it) instead of holding all three
          decoded tracks resident at once.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- KOLAI foreground media service (Media3 MediaSessionService). The
             media3 intent-filter lets MediaController/system media controls bind. -->
        <service
            android:name=".KolaiMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>