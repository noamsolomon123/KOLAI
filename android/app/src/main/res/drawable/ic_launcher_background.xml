<?xml version="1.0" encoding="utf-8"?>
<!-- KOLAI launcher background: midnight canvas with a soft diagonal
     violet->blue glow (top-right) and a faint amber accent (bottom-left). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Midnight base. -->
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"
        android:fillColor="#06060D" />

    <!-- Diagonal violet->blue glow from the top-right, fading into the dark. -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="104"
                android:startY="4"
                android:endX="22"
                android:endY="98"
                android:startColor="#D98B5CF6"
                android:centerColor="#8C3B82F6"
                android:endColor="#0006060D" />
        </aapt:attr>
    </path>

    <!-- Faint warm amber radial accent, bottom-left, very low alpha. -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="16"
                android:centerY="96"
                android:gradientRadius="44"
                android:startColor="#2EF59E0B"
                android:endColor="#00F59E0B" />
        </aapt:attr>
    </path>

</vector>
