<?xml version="1.0" encoding="utf-8"?>
<!-- KOLAI launcher foreground: white capsule microphone with cradle arc,
     stem and base bar, plus a green ON-AIR dot at the top-right.
     All content sits inside the central 66dp safe zone (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Mic capsule: fully-rounded rect, x 46..62, y 30..54 (radius 8). -->
    <path
        android:pathData="M46,38 A8,8 0 0 1 54,30 A8,8 0 0 1 62,38 L62,46 A8,8 0 0 1 54,54 A8,8 0 0 1 46,46 Z"
        android:fillColor="#FAFAFA" />

    <!-- Mic cradle: open arc below the capsule, centered (54,46) r=14. -->
    <path
        android:pathData="M40,46 A14,14 0 0 0 68,46"
        android:strokeColor="#FAFAFA"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- Stem: short vertical line from the cradle down to the base. -->
    <path
        android:pathData="M54,60 L54,69"
        android:strokeColor="#FAFAFA"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- Base bar. -->
    <path
        android:pathData="M46.5,70 L61.5,70"
        android:strokeColor="#FAFAFA"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- ON-AIR dot: solid green, r=5 at (66,34), with a thin midnight ring
         so it separates cleanly from the white capsule corner. -->
    <path
        android:pathData="M61,34 A5,5 0 1 1 71,34 A5,5 0 1 1 61,34 Z"
        android:fillColor="#1ED760"
        android:strokeColor="#06060D"
        android:strokeWidth="2" />

</vector>
