# Copy to .env and fill in. .env is gitignored.
# Radio AI runs fully free on Gemini: one provider for both DJ text and voice.

# Gemini API keys (free tier). Add 1-3 keys; extras enable auto-rotation on
# rate-limit, which multiplies your effective free quota.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_API_KEY_2=          # optional (rotation fallback)
GEMINI_API_KEY_3=          # optional (rotation fallback)

# Models
GEMINI_LLM_MODEL=gemini-3.1-flash-lite-preview
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Puck

# Optional: NOT needed by yt-dlp (it searches without a key). Reserved for
# future use if we switch to the YouTube Data API for richer search metadata.
YOUTUBE_API_KEY=

CACHE_DIR=./cache
